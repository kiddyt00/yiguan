<view class="container">
  <view wx:if="{{loading}}" class="text-center" style="color:#9E8C7A;padding:60rpx 0;">加载中...</view>

  <block wx:if="{{!loading && orders.length === 0}}">
    <view class="card text-center" style="padding:60rpx 0;">
      <view style="font-size:80rpx;">🧾</view>
      <view style="font-size:30rpx;color:#5D4037;margin-top:16rpx;">暂无订单</view>
      <text class="text-muted" style="display:block;margin-top:8rpx;">充值后可在这里查看订单记录</text>
      <button class="btn-primary mt-3" style="width:60%;" bindtap="goRecharge">去充值</button>
    </view>
  </block>

  <view wx:if="{{!loading && orders.length > 0}}" class="card" wx:for="{{orders}}" wx:key="id" style="margin-bottom:16rpx;">
    <view style="display:flex;justify-content:space-between;align-items:center;">
      <view style="font-size:28rpx;font-weight:600;">{{item.name}}</view>
      <view style="font-size:26rpx;color:{{item.isPaid?'#2E7D32':'#C62828'}};">{{item.status}}</view>
    </view>
    <view style="display:flex;justify-content:space-between;margin-top:12rpx;font-size:24rpx;color:#9E8C7A;">
      <text>¥{{item.amount}}</text>
      <text>{{item.time}}</text>
    </view>
    <view style="font-size:22rpx;color:#C8BFB4;margin-top:8rpx;">订单号 #{{item.id}}</view>
  </view>
</view>
