<view class="container">
  <view class="card text-center" style="padding-top:48rpx;">
    <image src="{{profile.avatar||'/images/default-avatar.svg'}}" mode="aspectFill" style="width:120rpx;height:120rpx;border-radius:60rpx;margin:0 auto;"></image>
    <view style="font-size:36rpx;font-weight:700;margin-top:16rpx;">{{profile.nickname || '易友'}}</view>
    <text class="text-muted">{{profile.phone || ''}}</text>
  </view>
  <!-- 充值 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:600;margin-bottom:8rpx;">💎 充值</view>
    <view wx:if="{{membership && membership.is_active}}" style="font-size:26rpx;color:#D4A853;display:block;margin-bottom:16rpx;">👑 会员有效 · {{membership.days_left}}天后到期</view>
    <text wx:else style="font-size:26rpx;color:#9E8C7A;display:block;margin-bottom:16rpx;">当前剩余：{{profile.remaining_quota || 0}} 次</text>
    <view style="display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:20rpx;">
      <view wx:for="{{products}}" wx:key="id" catchtap="selectProduct" data-id="{{item.id}}"
        style="flex:1;min-width:120rpx;padding:16rpx 8rpx;border-radius:12rpx;text-align:center;border:2rpx solid {{selected===item.id?'#D4A853':'#E0D6C8'}};background:{{selected===item.id?'#FFF8F0':'#FFF'}};">
        <view style="font-size:24rpx;">{{item.icon}}</view>
        <view style="font-size:24rpx;font-weight:600;margin-top:4rpx;">{{item.name}}</view>
        <view style="font-size:28rpx;font-weight:700;color:#D4A853;">¥{{item.price}}</view>
        <view wx:if="{{item.duration > 0}}" style="font-size:20rpx;color:#9E8C7A;">{{item.duration}}天不限次</view>
        <view wx:else style="font-size:20rpx;color:#9E8C7A;">{{item.quota}} 次</view>
      </view>
    </view>
    <button class="btn-primary" style="width:100%;" loading="{{payLoading}}" disabled="{{!selected}}" bindtap="doPay">
      {{payLoading ? '处理中...' : '微信支付'}}
    </button>
  </view>

  <!-- 我的订单 -->
  <view class="card" style="display:flex;justify-content:space-between;align-items:center;" bindtap="goOrders">
    <view style="font-size:28rpx;font-weight:600;">🧾 我的订单</view>
    <text style="color:#9E8C7A;font-size:26rpx;">查看 ›</text>
  </view>

  <view class="card">
    <view style="font-size:28rpx;font-weight:600;margin-bottom:16rpx;">编辑资料</view>
    <input value="{{form.nickname}}" bindinput="onNick" placeholder="昵称" class="input-field" style="margin-bottom:16rpx;" />
    <input value="{{form.address}}" bindinput="onAddr" placeholder="地址（选填）" class="input-field" style="margin-bottom:24rpx;" />
    <button class="btn-primary" style="width:100%;" bindtap="save">保存</button>
  </view>
  <!-- 邀请好友 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:600;margin-bottom:4rpx;">📤 邀请好友</view>
    <text style="font-size:24rpx;color:#9E8C7A;display:block;margin-bottom:12rpx;">每邀请3位好友注册，其中1人测算，得1次免费测算</text>
    <view wx:if="{{inviteCode}}" class="text-center">
      <button class="btn-primary mt-3" style="width:100%;font-size:26rpx;" bindtap="shareInvite">📤 邀请好友</button>
      <view style="display:flex;gap:12rpx;margin-top:12rpx;font-size:22rpx;color:#9E8C7A;text-align:center;">
        <view style="flex:1;"><view style="font-size:30rpx;font-weight:700;color:#5D4037;">{{inviteProgress.registered_count}}</view>已注册</view>
        <view style="flex:1;"><view style="font-size:30rpx;font-weight:700;color:#5D4037;">{{inviteProgress.divined_count}}</view>已测算</view>
        <view style="flex:1;"><view style="font-size:30rpx;font-weight:700;color:#5D4037;">{{inviteProgress.reward_round}}</view>已奖励</view>
      </view>
    </view>
    <view wx:else class="text-center" style="color:#9E8C7A;padding:12rpx 0;">加载中...</view>
  </view>

  <!-- 微信绑定 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:600;margin-bottom:12rpx;">微信绑定</view>
    <view wx:if="{{profile.openid}}" style="font-size:26rpx;color:#5D4037;margin-bottom:8rpx;">
      ✅ 已绑定微信账号
    </view>
    <view wx:else>
      <text class="text-muted" style="display:block;margin-bottom:8rpx;">绑定后可直接用微信登录</text>
      <button class="btn-secondary" style="width:100%;" loading="{{binding}}" bindtap="bindWechat">绑定微信</button>
    </view>
    <view wx:if="{{bindError}}" style="font-size:24rpx;color:#C62828;margin-top:8rpx;">{{bindError}}</view>
    <view wx:if="{{bindSuccess}}" style="font-size:24rpx;color:#2E7D32;margin-top:8rpx;">绑定成功</view>
  </view>
  <button class="btn-secondary mt-3" style="width:100%;" bindtap="logout">退出登录</button>
</view>
