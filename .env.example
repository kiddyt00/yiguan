# 易观 Docker 部署配置
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env

# LLM API Key（DashScope）
***REMOVED***

# JWT 密钥（建议改为随机字符串）
***REMOVED***

# 管理员账号
ADMIN_PHONE=13800000000
***REMOVED***

# 微信开放平台（网站扫码登录）
WX_OPEN_***REMOVED*** 微信支付（商户平台 pay.weixin.qq.com）
WX_PAY_MCHID=
# 小程序虚拟支付（米大师，iOS 虚拟商品；offerID 在 mp 后台虚拟支付基础配置）
WX_VP_OFFER_ID=
WX_VP_APP_KEY=
WX_VP_APP_KEY_SANDBOX=
WX_VP_SANDBOX=false
WX_VP_NOTIFY_URL=https://zgjz.insightj.cn/api/orders/virtual-notify
# 微信消息推送（虚拟支付发货订阅）：Token/EncodingAESKey 与 mp 后台配置一致
WX_VP_PUSH_TOKEN=
WX_VP_PUSH_AES_KEY=
***REMOVED*** 支付宝支付（开放平台 open.alipay.com）
ALIPAY_***REMOVED***

# 前端暴露端口
HTTP_PORT=80
