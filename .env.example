# 易观 Docker 部署配置
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env

# LLM API Key（DashScope）
LLM_API_KEY=sk-...

# JWT 密钥（建议改为随机字符串）
JWT_SECRET=your-secret-change-me

# 管理员账号
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=admin123

# 微信开放平台（网站扫码登录）
WX_OPEN_APPID=
WX_OPEN_SECRET=

# 微信支付（商户平台 pay.weixin.qq.com）
WX_PAY_MCHID=
WX_PAY_API_KEY=

# 前端暴露端口
HTTP_PORT=80
